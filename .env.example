# Environment variables
# ADT Store: server-only settings (use the origin, without /api/v1).
# Use a different port if ADT Store runs locally alongside this portal.
NUXT_ADT_STORE_BASE_URL=
# Read-only integration key issued by ADT Store; never expose via runtimeConfig.public.
NUXT_ADT_STORE_API_KEY=
NUXT_AI_DATABASE_URL=
NUXT_SUPABASE_URL=
NUXT_SUPABASE_ANON_KEY=
# Backend API root. Browser requests use /api/backend/v1 on the portal origin.
# NUXT_BACKEND_API_BASE_URL can override this server-side at deployment time.
VITE_API_BASE_URL=
# Build-time override for image fetching. The /api/v1 build default uses
# http://gateway on Docker; set this for builds with an absolute API URL.
# IPX maps public /api/uploads paths through this internal gateway origin.
NUXT_IMAGE_INTERNAL_ORIGIN=
# Server-only. Base URL for the figures (textbook image) API. Defaults to the LIVE server if
# unset - on dev/local, this MUST point at the same backend that issues the signInAccessToken
# cookie (e.g. VITE_API_BASE_URL's host), or every figure lookup fails with 401 Unauthorized.
FIGURES_API_BASE_URL=
CONVERSATION_CHAPTER_ID=
CONVERSATION_AUTH_TOKEN=

PIPER_PYTHON= /absolute/path/to/python
PIPER_VOICES_DIR=  ../piper/voices
TTS_SPEED= 1.0
TTS_DEFAULT_VOICE_FEMALE= jenny_dioco|alba|aru|semaine|vctk|cori|southern_english_female
TTS_DEFAULT_VOICE_MALE= alan|northern_english_male

# Support API root (pending backend implementation)
NUXT_SUPPORT_API_BASE_URL=

# Local end-to-end testing only; both apps must point at the same absolute file.
INBOX_DEMO_ENABLED=false
INBOX_DEMO_FILE=
