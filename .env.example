# Environment variables
# ADT Store: server-only settings (use the origin, without /api/v1).
# Use a different port if ADT Store runs locally alongside this portal.
NUXT_ADT_STORE_BASE_URL=
# Read-only integration key issued by ADT Store; never expose via runtimeConfig.public.
NUXT_ADT_STORE_API_KEY=
NUXT_AI_DATABASE_URL=
NUXT_SUPABASE_URL=
NUXT_SUPABASE_ANON_KEY=
# Backend API root. Browser requests use /api/backend/v1 on the portal origin.
# NUXT_BACKEND_API_BASE_URL can override this server-side at deployment time.
VITE_API_BASE_URL=
# Fetch a backend CSRF token and its csrf_token cookie for proxied POST/PUT/PATCH/DELETE requests.
# Enabled by default. Set to false only for a backend that does not require CSRF.
# For a production Node process, rebuild after changing this .env value, or
# provide NUXT_CSRF_ENABLED to the running process and restart it.
NUXT_CSRF_ENABLED=true
# Server runtime override for image fetching. Set a host reachable from PM2
# when the public uploads origin cannot be reached by the deployment server.
# Card images use this origin only for IPX; fallback URLs remain public.
NUXT_PUBLIC_IMAGE_FETCH_ORIGIN=
# Server-only. Base URL for the figures (textbook image) API. Defaults to the LIVE server if
# unset - on dev/local, this MUST point at the same backend that issues the signInAccessToken
# cookie (e.g. VITE_API_BASE_URL's host), or every figure lookup fails with 401 Unauthorized.
FIGURES_API_BASE_URL=
CONVERSATION_CHAPTER_ID=
CONVERSATION_AUTH_TOKEN=

PIPER_PYTHON= /absolute/path/to/python
PIPER_VOICES_DIR=  ../piper/voices
TTS_SPEED= 1.0
TTS_DEFAULT_VOICE_FEMALE= jenny_dioco|alba|aru|semaine|vctk|cori|southern_english_female
TTS_DEFAULT_VOICE_MALE= alan|northern_english_male

# Support API root (pending backend implementation)
# Optional override; defaults to the existing backendApiBaseUrl.
NUXT_SUPPORT_API_BASE_URL=

# Local end-to-end testing only; both apps must point at the same absolute file.
INBOX_DEMO_ENABLED=false
INBOX_DEMO_FILE=

# AI teacher / AI search (server-only)
# OpenAI key for /api/chat, /api/ai/search and /api/ai-assistant/ask.
OPENAI_API_KEY=
# Insights (textbook RAG) base URL, e.g. https://insights.example.tz (no trailing slash).
# Required: there is no default. NUXT_RAG_API_BASE_URL overrides it at runtime.
RAG_API_BASE_URL=
# Insights X-API-Key. NUXT_INSIGHTS_API_KEY overrides it at runtime.
INSIGHTS_API_KEY=
# Optional per-user limits (requests per minute) for the AI routes.
AI_RATE_LIMIT_PER_MINUTE=20
AI_TTS_RATE_LIMIT_PER_MINUTE=90
# Optional: kill a Piper TTS process after this many milliseconds.
TTS_PIPER_TIMEOUT_MS=60000
