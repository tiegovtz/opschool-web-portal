# Environment variables
# ADT Store: server-only settings (use the origin, without /api/v1).
# Use a different port if ADT Store runs locally alongside this portal.
NUXT_ADT_STORE_BASE_URL=
# Read-only integration key issued by ADT Store; never expose via runtimeConfig.public.
NUXT_ADT_STORE_API_KEY=
NUXT_AI_DATABASE_URL=
NUXT_SUPABASE_URL=
NUXT_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
CONVERSATION_CHAPTER_ID=
CONVERSATION_AUTH_TOKEN=

PIPER_PYTHON= /absolute/path/to/python
PIPER_VOICES_DIR=  ../piper/voices
TTS_SPEED= 1.0
TTS_DEFAULT_VOICE_FEMALE= jenny_dioco|alba|aru|semaine|vctk|cori|southern_english_female
TTS_DEFAULT_VOICE_MALE= alan|northern_english_male
