# ===========================
# API Configuration
# ===========================
NUXT_API_BASE_URL="https://your.api.domain/v1"

# ===========================
# Server Configuration
# ===========================
NUXT_LOCAL_NETWORK_IP="127.0.0.1"
NUXT_RUNNING_PORT="3000"

# ===========================
# Security Configuration
# ===========================
NUXT_ENABLE_SECURITY="true"

# Enable CSRF protection
NUXT_CSRF="true"

# Enable dynamic nonce for inline scripts/styles
NUXT_NONCE="true"

# Enable Subresource Integrity (SRI)
NUXT_SRI="true"

# ===========================
# Content Security Policy (CSP)
# ===========================
NUXT_CSP_SCRIPT_SRC="'self' 'strict-dynamic' 'nonce-{{nonce}}' https:"
NUXT_CSP_STYLE_SRC="'self' https: 'nonce-{{nonce}}'"
NUXT_CSP_IMG_SRC="'self' data: blob: https://your.api.domain http://127.0.0.1:3000"
NUXT_CSP_OBJECT_SRC="'none'"
NUXT_CSP_FORM_ACTION="'self'"
NUXT_CSP_FRAME_ANCESTORS="'none'"
NUXT_CSP_FONT_SRC="'self' https: data:"
NUXT_CSP_BASE_URI="'none'"
NUXT_CSP_CONNECT_SRC="'self' https: ws: blob:"
NUXT_CSP_UPGRADE_INSECURE_REQUESTS="true"

# ===========================
# Referrer Policy
# ===========================
NUXT_REFERRER_POLICY="strict-origin-when-cross-origin"

# ===========================
# Rate Limiting
# ===========================
# Max 150 requests every 5 minutes
NUXT_RATE_LIMIT_TOKENS_PER_INTERVAL="150"
NUXT_RATE_LIMIT_INTERVAL="300000"

# ===========================
# Request Size Limits
# ===========================
NUXT_MAX_REQUEST_SIZE="2000000"     # 2MB
NUXT_MAX_UPLOAD_SIZE="8000000"     # 8MB

# ===========================
# CORS Configuration
# ===========================
NUXT_CORS_ALLOWED_ORIGIN="https://your.api.domain, http://127.0.0.1:3000, https://api.iconify.design/"
NUXT_ALLOWED_DOMAINS="blob:, ws://127.0.0.1:3000, https://your.api.domain"
NUXT_CORS_ALLOWED_METHODS="GET,HEAD,PUT,PATCH,POST,DELETE"
NUXT_CORS_PREFLIGHT_STATUS="204"
